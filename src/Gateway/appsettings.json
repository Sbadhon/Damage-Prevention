{
  
    "Jwt": {
      "Issuer": "http://authdevsvc",
      "Audience": "damage-prevention-api",
      "Secret": "super-dev-secret-change-me-please-32bytes"
    },
    "ReverseProxy": {
      "Routes": {
        "tickets": {
          "ClusterId": "ticketCluster",
          "Match": { "Path": "/api/tickets/{**catch-all}" }
        },
        "workorders": {
          "ClusterId": "schedulingCluster",
          "Match": { "Path": "/api/workorders/{**catch-all}" }
        },
        "risk": {
          "ClusterId": "riskCluster",
          "Match": { "Path": "/api/riskassessments/{**catch-all}" }
        }
      },
      "Clusters": {
        "ticketCluster": {
          "Destinations": {
            "ticketService": { "Address": "http://localhost:5030/" }
          }
        },
        "schedulingCluster": {
          "Destinations": {
            "schedulingService": { "Address": "http://localhost:5076/" }
          }
        },
        "riskCluster": {
          "Destinations": {
            "riskService": { "Address": "http://localhost:5279/" }
          }
        }
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "AllowedHosts": "*"
  }