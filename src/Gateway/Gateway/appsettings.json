{
  "Jwt": {
    "Issuer": "http://authdevsvc",
    "Audience": "damage-prevention-api",
    "Secret": "super-dev-secret-change-me-please-32bytes"
  },

  "ReverseProxy": {
    "Routes": {
      "assets-route": {
        "ClusterId": "assets-cluster",
        "Match": {
          "Path": "/assets/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/assets" }
        ]
      },
      "tickets-route": {
        "ClusterId": "tickets-cluster",
        "Match": {
          "Path": "/tickets/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/tickets" }
        ]
      }
    },
    "Clusters": {
      "assets-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5209"
          }
        }
      },
      "tickets-cluster": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5030"
          }
        }
      }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
