{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "WorkOrders": {
    "DefaultCrew": "Crew A",
    "DefaultDurationMinutes": 45,
    "SLA": {
      "HighRiskPriorityMinutes": 30,
      "MediumRiskPriorityMinutes": 120,
      "LowRiskPriorityMinutes": 240
    }
  },

  "TicketEvents": {
    "UseKafka": true,
    "UseAzureServiceBus": false,

    "Kafka": {
      "BootstrapServers": "localhost:9092",
      "TicketSubmittedTopic": "ticket-submitted",
      "GroupId": "scheduling-consumers"
    },

    "AzureServiceBus": {
      "ConnectionString": "UseDevelopmentStorage=true",
      "TopicName": "ticket-submitted",
      "SubscriptionName": "scheduling-worker"
    }
  },

  "Persistence": {
    "UsePostgres": true,
    "ConnectionString": "Host=localhost;Port=5432;Database=scheduleddb;Username=scheduser;Password=schedpass"
  },

  "Tenancy": {
    "RequiredHeader": "X-Tenant-Id"
  }
}
