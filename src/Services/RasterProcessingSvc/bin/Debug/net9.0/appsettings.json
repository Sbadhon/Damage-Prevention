{
  "RasterProcessing": {
    "UseGpuAcceleration": false,

    "Layers": {
      "SoilType": "data/soil/soiltype.tif",
      "UtilityDensity": "data/utilities/utility_density.tif",
      "GroundStability": "data/stability/stability_index.tif"
    },

    "Buffering": {
      "DefaultBufferMeters": 2,
      "MaxBufferMeters": 10
    },

    "DataSources": {
      "UseLocal": true,
      "UseAzureBlob": false,

      "Local": {
        "BasePath": "data/"
      },

      "AzureBlob": {
        "ConnectionString": "UseDevelopmentStorage=true",
        "ContainerName": "gis-layers"
      }
    }
  },

  "Tenancy": {
    "RequiredHeader": "X-Tenant-Id"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  }
}
